@using Blazor.Pages
@inherits LayoutComponentBase

<div class="page">
    <main>
        <div class="navbar">
            <div class="navbar-left">
                <span class="navbar-title">GymTrack</span>
            </div>

            <button class="menu-toggle" @onclick="ToggleMenu">
                ☰
            </button>

            <AuthorizeView>
                <Authorized>
                    <nav class="nav-links @(mobileMenuOpen ? "show" : "")">
                        <a @onclick='() => NavigateTo("/")'>Dashboard</a>
                        <a @onclick='() => NavigateTo("/Planning")'>Planning</a>
                        <a @onclick='() => NavigateTo("/Workouts")'>Workouts</a>
                        <a @onclick='() => NavigateTo("/Musclegroups")'>Exercises</a>
                        <button class="logout-btn" @onclick="Logout">Logout</button>
                    </nav>
                </Authorized>

                <NotAuthorized>
                    <nav class="nav-links auth-links @(mobileMenuOpen ? "show" : "")">
                        <a @onclick='() => NavigateTo("/Login")'>Login</a>
                        <a @onclick='() => NavigateTo("/Register")'>Register</a>
                    </nav>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <Toast />

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool mobileMenuOpen;

    [Inject] private CustomAuthStateProvider AuthenticationService { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void ToggleMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void NavigateTo(string url)
    {
        mobileMenuOpen = false;
        Navigation.NavigateTo(url);
    }

    private void Logout()
    {
        mobileMenuOpen = false;

        AuthenticationService.Logout();

        ToastService.ShowToast(
            "Logged out successfully!",
            ToastLevel.Success);

        Navigation.NavigateTo("/");
    }
}
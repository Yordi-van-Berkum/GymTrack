@page "/Register"
@using Blazor.Models.Auth

<div class="page-container">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-title">Register</div>

            <div class="auth-divider"></div>

            <EditForm Model="registerDto" OnValidSubmit="RegisterAsync">
                <DataAnnotationsValidator />

                <div class="auth-form">
                    <div class="auth-form-group">
                        <label class="auth-label">User Name</label>
                        <InputText class="auth-input" @bind-Value="registerDto.UserName" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.UserName)" />
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label">First Name</label>
                        <InputText class="auth-input" @bind-Value="registerDto.FirstName" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.FirstName)" />
                     </div>

                    <div class="auth-form-group">
                        <label class="auth-label">Last Name</label>
                        <InputText class="auth-input" @bind-Value="registerDto.LastName" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.LastName)" />
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label">Date Of Birth</label>
                        <InputDate class="auth-input" @bind-Value="registerDto.DateOfBirth" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.DateOfBirth)" />
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label">Email</label>
                        <InputText type="email" class="auth-input" @bind-Value="registerDto.Email" autocomplete="email" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.Email)" />
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label">Length (cm)</label>
                        <InputNumber class="auth-input" @bind-Value="registerDto.Height" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.Height)" />
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label">Weight (kg)</label>
                        <InputNumber class="auth-input" @bind-Value="registerDto.Weight" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.Weight)" />
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label">Password</label>
                        <InputText type="password" class="auth-input" @bind-Value="registerDto.Password" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.Password)" />
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label">Repeat Password</label>
                        <InputText type="password" class="auth-input" @bind-Value="registerDto.ConfirmPassword" />
                        <ValidationMessage class="auth-alert" For="@(() => registerDto.ConfirmPassword)" />
                    </div>

                    <div class="auth-buttons">
                        <button class="auth-btn" disabled="@isLoading">
                                    @(isLoading ? "Loading..." : "Register")
                                </button>
                        <a class="auth-btn-cancel" href="/Login">Log In</a>
                    </div>
                </div>
             </EditForm>
        </div>
    </div>
</div>

@code {
    // Model waarin alle registratiegegevens van de gebruiker worden opgeslagen
    private RegisterDto registerDto = new();

    // Injecteren van benodigheden van de pagina
    [Inject] private CustomAuthStateProvider AuthenticationService { get; set; } = default!;
    [Inject] ToastService ToastService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool isLoading = false;


    private async Task RegisterAsync()
    {
        // Voorkomt dat er meerdere registratieverzoeken tegelijk worden verstuurd.
        if (isLoading)
            return;

        try
        {
            // Zet de loadingstatus aan zodat de gebruiker niet opnieuw kan klikken.
            isLoading = true;

            // Voert de regristratie uit via de authentication service.
            var message = await AuthenticationService.RegisterAsync(registerDto);

            // Geeft een toast message aan de gebruiker wanneer regristratie succesvol is.
            ToastService.ShowToast(message, ToastLevel.Success);

            // Navigeert naar de homepagina.
            Navigation.NavigateTo("/Login");
        }
        catch (Exception ex)
        {
            // Toont de toast met de ontvangen foutmelding wanneer het regristreren niet gelukt is.
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            // Zet de loadingstatus weer uit.
            isLoading = false;
        }
    }
}
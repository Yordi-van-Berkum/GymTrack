@page "/Login"
@using Blazor.Models.Auth


<div class="page-container">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-title">Log In</div>

            <div class="register-divider"></div>

            <EditForm Model="loginDto" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />

                <div class="auth-form">
                    <div class="auth-form-group">
                        <label class="auth-label">Email</label>
                        <InputText class="auth-input" @bind-Value="loginDto.Email" autocomplete="email" />
                        <ValidationMessage class="auth-alert" For="@(() => loginDto.Email)" />
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label">Password</label>
                        <InputText type="password" class="auth-input" @bind-Value="loginDto.Password" />
                        <ValidationMessage class="auth-alert" For="@(() => loginDto.Password)" />
                    </div>

                    <div class="auth-buttons">
                        <button class="auth-btn" disabled="@isLoading">
                            @(isLoading ? "Loading..." : "Log In")
                        </button>
                        <a class="auth-btn-cancel" href="/Register">Register</a>
                    </div>
                </div>
            </EditForm>
         </div>
     </div>
</div>

@code {
    // Model waarin de login gegevens van de gebruiker worden opgeslagen.
    private LoginDto loginDto = new();

    // Voorkomt dat de gebruiker meerdere login requests tegelijk verstuurd.
    private bool isLoading = false;

    // Injecteren van benodigheden van de pagina
    [Inject] private CustomAuthStateProvider AuthenticationService { get; set; } = default!;
    [Inject] ToastService ToastService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;



    private async Task LoginAsync()
    {
        // Voorkomt dat er meerdere loginverzoeken tegelijk worden verstuurd.
        if (isLoading)
            return;

        try
        {
            // Zet de loadingstatus aan zodat de gebruiker niet opnieuw kan klikken.
            isLoading = true;

            // Voert de login uit via de authentication service.
            await AuthenticationService.LoginAsync(loginDto);

            // Geeft een toast message aan de gebruiker wanneer login succesvol is.
            ToastService.ShowToast("Login successful!", ToastLevel.Success);

            // Navigeert naar de homepagina.
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            // Toont de toast met de ontvangen foutmelding wanneer het inloggen niet gelukt is.
            ToastService.ShowToast(ex.Message,ToastLevel.Error);
        }
        finally
        {
            // Zet de loadingstatus weer uit.
            isLoading = false;
        }
    }
}

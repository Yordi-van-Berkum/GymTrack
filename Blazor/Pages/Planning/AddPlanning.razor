@page "/AddDayPlanning/{Day}"
@implements IDisposable

<div class="page-container">
    <div class="pagetitle-back">
        <BackButton />
        <div class="pagetitle">Add Workout To @Day</div>
    </div>

    <div class="search">
        <i class="fa fa-search search-icon fa-fw"></i>
        <input type="text" class="search-input" placeholder="Search..." @bind="searchTerm" @bind:event="oninput" />
    </div>

    @if (isLoading)
    {
        <p class="status-message">Loading workouts...</p>
    }
    else if (!myWorkouts.Any())
    {
        <p class="status-message">No workouts found.</p>
    }
    else
    {
        <div class="workout-container">
            @foreach (var workout in FilteredMyWorkouts)
            {
                <div class="workout-card" @onclick="() => OpenConfirmAddWorkoutToPlanningPopup(workout)">
                    <div class="workout-icon-wrapper"><i class="@GetWorkoutIcon(workout.Type) workout-icon"></i></div>
                    <div class="workout-name">@workout.Name</div>
                    <div class="workout-count"><span>@workout.ExerciseCount</span> exercises</div>
                </div>
            }
        </div>
    }
</div>

@if (showConfirmAddWorkoutToPlanningPopup)
{
    <div class="confirm-modal-overlay">
        <div class="confirm-modal-content">
            <div class="confirm-modal-title">Add <span>@selectedWorkoutName</span> To <span>@Day</span></div>

            <div class="confirm-modal-actions">
                <button class="confirm-modal-btn confirm-modal-btn-cancel" @onclick="ClosePopup" disabled="@isAddingWorkout"><i class="fa-solid fa-x"></i>Cancel</button>
                <button class="confirm-modal-btn confirm-modal-btn-confirm" @onclick="ConfirmAddWorkoutToPlanning" disabled="@isAddingWorkout"><i class="fa-solid fa-plus"></i>Confirm</button>
            </div>
        </div>
    </div>
}

@code {
    private string searchTerm = string.Empty;
    private DayOfWeek SelectedDay;
    private bool showConfirmAddWorkoutToPlanningPopup;
    private Guid selectedWorkoutId;
    private string selectedWorkoutName = string.Empty;
    private bool isAddingWorkout;
    private bool isLoading;
    private List<Workout> myWorkouts = new();

    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private CancellationToken cancellationToken => _cancellationTokenSource.Token;

    [Parameter]
    public string? Day { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private PlanningService PlanningService { get; set; } = default!;
    [Inject] private WorkoutsService WorkoutsService { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            isLoading = true;
            await LoadMyWorkoutsAsync();
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de pagina wordt verlaten.
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMyWorkoutsAsync()
    {
        myWorkouts = await WorkoutsService.GetMyWorkoutsAsync(cancellationToken);
    }

    private string GetWorkoutIcon(WorkoutType type)
    {
        return type switch
        {
            WorkoutType.Strength => "fa-solid fa-dumbbell strength-icon",
            WorkoutType.Cardio => "fa-solid fa-heart-pulse cardio-icon",
            WorkoutType.Mixed => "fa-solid fa-fire mixed-icon",
            _ => "fa-solid fa-dumbbell"
        };
    }

    private void ClosePopup()
    {
        showConfirmAddWorkoutToPlanningPopup = false;
    }

    private void OpenConfirmAddWorkoutToPlanningPopup(Workout workout)
    {
        selectedWorkoutId = workout.Id;
        selectedWorkoutName = workout.Name;
        showConfirmAddWorkoutToPlanningPopup = true;
    }

    private async Task ConfirmAddWorkoutToPlanning()
    {
        if (isAddingWorkout)
            return;

        isAddingWorkout = true;
        showConfirmAddWorkoutToPlanningPopup = false;

        try
        {
            var message = await PlanningService.AddWorkoutToPlanningAsync(selectedWorkoutId, SelectedDay, cancellationToken);

            ToastService.ShowToast(message, ToastLevel.Success);
            Navigation.NavigateTo("/Planning");
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de pagina wordt verlaten.
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isAddingWorkout = false;
        }
    }

    private IEnumerable<Workout> FilteredMyWorkouts =>
        myWorkouts.Where(x =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            x.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        if (Enum.TryParse<DayOfWeek>(Day, true, out var day))
        {
            SelectedDay = day;
        }
        else
        {
            Navigation.NavigateTo("/Planning");
        }
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
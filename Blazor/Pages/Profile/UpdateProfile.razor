@page "/UpdateProfile"
@attribute [Authorize]
@implements IDisposable

<div class="page-container">
    <div class="pagetitle-back">
        <BackButton />
        <div class="pagetitle">Update Profile</div>
    </div>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-title">My Profile</div>
            <div class="auth-divider"></div>

            @if (isLoadingProfile)
            {
                <p class="status-message">Loading profile...</p>
            }
            else if (userProfile is null)
            {
                <p class="status-message">Profile not found.</p>
            }
            else
            {
                <EditForm Model="userProfile" OnValidSubmit="UpdateProfileAsync">
                    <DataAnnotationsValidator />

                    <div class="auth-form">
                        <div class="auth-form-group">
                            <label class="auth-label">User Name</label>
                            <InputText class="auth-input" @bind-Value="userProfile.UserName" />
                            <ValidationMessage class="auth-alert" For="@(() => userProfile.UserName)" />
                        </div>

                        <div class="auth-form-group">
                            <label class="auth-label">First Name</label>
                            <InputText class="auth-input" @bind-Value="userProfile.FirstName" />
                            <ValidationMessage class="auth-alert" For="@(() => userProfile.FirstName)" />
                        </div>

                        <div class="auth-form-group">
                            <label class="auth-label">Last Name</label>
                            <InputText class="auth-input" @bind-Value="userProfile.LastName" />
                            <ValidationMessage class="auth-alert" For="@(() => userProfile.LastName)" />
                        </div>

                        <div class="auth-form-group">
                            <label class="auth-label">Date Of Birth</label>
                            <InputDate class="auth-input" @bind-Value="userProfile.DateOfBirth" />
                            <ValidationMessage class="auth-alert" For="@(() => userProfile.DateOfBirth)" />
                        </div>

                        <div class="auth-form-group">
                            <label class="auth-label">Email</label>
                            <InputText type="email" class="auth-input" @bind-Value="userProfile.Email" autocomplete="email" />
                            <ValidationMessage class="auth-alert" For="@(() => userProfile.Email)" />
                        </div>

                        <div class="auth-form-group">
                            <label class="auth-label">Length (cm)</label>
                            <InputNumber class="auth-input" @bind-Value="userProfile.Height" />
                            <ValidationMessage class="auth-alert" For="@(() => userProfile.Height)" />
                        </div>

                        <div class="auth-form-group">
                            <label class="auth-label">Weight (kg)</label>
                            <InputNumber class="auth-input" @bind-Value="userProfile.Weight" />
                            <ValidationMessage class="auth-alert" For="@(() => userProfile.Weight)" />
                        </div>

                        <div class="auth-buttons">
                            <button type="submit" class="auth-btn" disabled="@isSaving">
                                @(isSaving ? "Saving..." : "Save Changes")
                            </button>

                            <a class="auth-btn-cancel" href="/Profile">Cancel</a>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Inject] private AccountService AccountService { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private UserProfileDto? userProfile;

    private bool isLoadingProfile = true;
    private bool isSaving;

    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private CancellationToken cancellationToken => _cancellationTokenSource.Token;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Haalt de profielgegevens op van de ingelogde gebruiker.
            var profile = await AccountService.GetMyProfileAsync(cancellationToken);

            // Zet de opgehaalde gegevens om naar de DTO voor het formulier.
            if (profile is not null)
            {
                userProfile = new UserProfileDto
                {
                    UserName = profile.UserName,
                    FirstName = profile.FirstName,
                    LastName = profile.LastName,
                    DateOfBirth = profile.DateOfBirth,
                    Email = profile.Email,
                    Height = profile.Height,
                    Weight = profile.Weight
                };
            }
        }
        catch (OperationCanceledException)
        {
            // Request geannuleerd bij verlaten pagina.
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isLoadingProfile = false;
        }
    }

    private async Task UpdateProfileAsync()
    {
        if (isSaving || userProfile is null)
            return;

        try
        {
            isSaving = true;

            // Verstuurt de aangepaste profielgegevens naar de backend.
            var message = await AccountService.UpdateMyProfileAsync(userProfile, cancellationToken);

            // Toont de succesmelding van de backend.
            ToastService.ShowToast(message, ToastLevel.Success);

            // Navigeert terug naar de profielpagina.
            Navigation.NavigateTo("/Profile");
        }
        catch (OperationCanceledException)
        {
            // Request geannuleerd.
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}

@page "/WorkoutDetail/{WorkoutId:guid}"

<div class="page-container">
    @if (isLoading)
    {
        <p class="status-message">Loading workout...</p>
    }
    else if (myWorkout is null)
    {
        <p class="status-message">Workout not found.</p>
    }
    else
    {
        <div class="pagetitle-back">
            <BackButton />
            <div class="pagetitle">@myWorkout.Name</div>
            <div class="action-buttons">
                <button class="button-pageheader update-button" @onclick="() => NavigateToUpdateToWorkout()"> <i class="fa-solid fa-pen-to-square"></i> <span>Update Workout</span></button>
                <button class="button-pageheader delete-button" @onclick="() => OpenConfirmDeleteWorkoutPopup()"> <i class="fa-solid fa-x"></i> <span>Delete Workout</span></button>
                <button class="button-pageheader add-button" @onclick="NavigateToAddExerciseToWorkout"> <i class="fa-solid fa-plus"></i><span>Add Exercise</span></button>
            </div>
        </div>

        <div class="exercise-container">
            @foreach (var exercise in workoutExercises)
            {
                <div class="exercise-card" @onclick="() => ExerciseDetail(exercise.Id)">
                    <div class="exercise-image-wrapper">
                        <img src="@($"/Images/Exercises/{exercise.ImageUrl}")"
                             alt="@exercise.Name"
                             class="exercise-image" />
                    </div>

                    <div class="exercise-name">
                        @exercise.Name
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showConfirmDeleteWorkoutPopup)
{
    <div class="confirm-modal-overlay">
        <div class="confirm-modal-content">
            <div class="confirm-modal-title">You want to delete <span>@myWorkout.Name</span>? </div>

            <div class="confirm-modal-actions">
                <button class="confirm-modal-btn confirm-modal-btn-cancel" @onclick="ClosePopup" disabled="@isDeletingWorkout"><i class="fa-solid fa-x"></i>Cancel</button>
                <button class="confirm-modal-btn confirm-modal-btn-delete" @onclick="ConfirmDeleteWorkout" disabled=@isDeletingWorkout"><i class="fa-solid fa-trash"></i>@(isDeletingWorkout ? "Deleting..." : "Delete")</button>
            </div>
        </div>
    </div>
}

@code {
    // Meegestuurde WorkoutId vanuit de workouts pagina.
    [Parameter] public Guid WorkoutId { get; set; }

    // Opgehaalde workout
    private Workout myWorkout;

    // Lijst met oefenignen
    private List<Exercise> workoutExercises = new();

    // Boolean om pagina in te laden wanneer alles opgehaald is wordt die false en toont die de pagina
    private bool isLoading;

    // Boolean om confirm popup te tonen
    private bool showConfirmDeleteWorkoutPopup = false;


    // Boolean zorgt ervoor dat wanneer je op de knop klikt om de workout te verwijderen dat deze knop inactief wordt.
    private bool isDeletingWorkout;

    // Wordt gebruikt om lopende requests te annuleren wanneer de pagina wordt verlaten.
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    // Injecteren van benodigheden van de pagina
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private WorkoutsService WorkoutsService { get; set; } = default!;
    [Inject] ToastService ToastService { get; set; } = default!;

    // Aanroepen van de LoadAllDataAsync functie bij het inladen van de pagina.
    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    // Zorgt ervoor dat de pagina pas inlaad wanneer alle functie zijn aangeroepen.
    private async Task LoadAllDataAsync()
    {
        try
        {
            isLoading = true;

            await Task.WhenAll(
                LoadMyWorkoutAsync(_cancellationTokenSource.Token),
                LoadExercisesAsync(_cancellationTokenSource.Token)
            );
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd omdat de pagina is verlaten.
        }
        finally
        {
            isLoading = false;
        }
    }

    // Ophalen van een workout.
    private async Task LoadMyWorkoutAsync(CancellationToken cancellationToken)
    {
        myWorkout = await WorkoutsService.GetWorkoutByIdAsync(WorkoutId, cancellationToken);
    }

    // Verwijderen van een workout.
    private async Task ConfirmDeleteWorkout()
    {
        // Voorkomt dat er meerdere delete requests tegelijk worden verstuurd.
        if (isDeletingWorkout)
            return;

        // Zorgt ervoor dat de knoppen tijdens het verwijderen inactief worden.
        isDeletingWorkout = true;

        // Zorgt ervoor dat de bevestigingspopup verdwijnt.
        showConfirmDeleteWorkoutPopup = false;

        try
        {
            // Verwijdert de workout en ontvangt een bericht terug.
            var message = await WorkoutsService.DeleteWorkoutAsync(WorkoutId, _cancellationTokenSource.Token);

            // Toon een succesmelding wanneer de workout succesvol is verwijderd.
            ToastService.ShowToast(message, ToastLevel.Success);

            // Navigeert terug naar de workouts-pagina.
            Navigation.NavigateTo("/Workouts");
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd omdat de component wordt verlaten.
        }
        catch (Exception ex)
        {
            // Toon een foutmelding wanneer er iets fout is gegaan.
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            // Maakt de knoppen weer actief.
            isDeletingWorkout = false;
        }
    }

    // Ophalen van de oefeningen van een workout.  
    private async Task LoadExercisesAsync(CancellationToken cancellationToken)
    {
        workoutExercises = await WorkoutsService.GetExercisesByWorkoutIdAsync(WorkoutId, cancellationToken);
    }

    // Navigeren naar de spiergroepen pagina om vanuit daar een oefening aan de workout toe te kunnen voegen.
    private void NavigateToAddExerciseToWorkout()
    {
        Navigation.NavigateTo($"/MuscleGroups/{WorkoutId}");
    }

    // Navigeren naar de detail pagina van de oefening.
    private void ExerciseDetail(int exerciseId)
    {
        Navigation.NavigateTo($"/ExerciseDetail/{exerciseId}");
    }
    
    // Navigeren naar de detail pagina van de oefening.
    private void NavigateToUpdateToWorkout()
    {
        Navigation.NavigateTo($"/CreateAndUpdateWorkout/{WorkoutId}");
    }


    private void ClosePopup()
    {
        // Zet boolean weer op false zodat popup verdwijnt.
        showConfirmDeleteWorkoutPopup = false;
    }

    // Annuleert lopende requests wanneer de component wordt verwijderd.
    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    // Zet de bool op true zodat popup getoond wordt.
    private void OpenConfirmDeleteWorkoutPopup()
    {
        showConfirmDeleteWorkoutPopup = true;
    }
}
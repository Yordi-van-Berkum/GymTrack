@page "/WorkoutDetail/{WorkoutId:guid}"
@implements IDisposable

<div class="page-container">

    @if (isLoading)
    {
        <p class="status-message">Loading workout...</p>
    }
    else if (myWorkout is null)
    {
        <p class="status-message">Workout not found.</p>
    }
    else
    {
        <div class="pagetitle-back">
            <BackButton />
            <div class="pagetitle">@myWorkout.Name</div>

            <button class="mobile-menu-button" @onclick="ToggleMobileActions">
                <i class="fa-solid fa-ellipsis-vertical"></i>
            </button>

            <div class="action-buttons @(showMobileActions ? "mobile-actions-open" : "")">
                <button class="button-pageheader start-button" @onclick="StartWorkout" disabled="@isStartingWorkout">
                    <i class="fa-solid fa-play"></i>
                    <span>@(isStartingWorkout ? "Starting..." : "Start Workout")</span>
                </button>

                <button class="button-pageheader history-button" @onclick="NavigateToWorkoutHistory">
                    <i class="fas fa-history"></i>
                    <span>History</span>
                </button>

                <button class="button-pageheader update-button" @onclick="NavigateToUpdateToWorkout">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Update Workout</span>
                </button>

                <button class="button-pageheader delete-button" @onclick="OpenConfirmDeleteWorkoutPopup">
                    <i class="fa-solid fa-x"></i>
                    <span>Delete Workout</span>
                </button>

                <button class="button-pageheader add-button" @onclick="NavigateToAddExerciseToWorkout">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add Exercise</span>
                </button>
            </div>
        </div>

        <div class="exercise-container">
            @foreach (var exercise in workoutExercises)
            {
                <div class="exercise-card" @onclick="() => ExerciseDetail(exercise.Id)">
                    <div class="exercise-image-wrapper">
                        <img src="@($"/Images/Exercises/{exercise.ImageUrl}")" alt="@exercise.Name" class="exercise-image" />
                    </div>

                    <div class="exercise-name">@exercise.Name</div>
                </div>
            }
        </div>
    }

</div>

@if (showConfirmDeleteWorkoutPopup)
{
    <div class="confirm-modal-overlay">
        <div class="confirm-modal-content">
            <div class="confirm-modal-title">
                You want to delete <span>@myWorkout?.Name</span>?
            </div>

            <div class="confirm-modal-actions">
                <button class="confirm-modal-btn confirm-modal-btn-cancel" @onclick="ClosePopup" disabled="@isDeletingWorkout">
                    <i class="fa-solid fa-x"></i>
                    Cancel
                </button>

                <button class="confirm-modal-btn confirm-modal-btn-delete" @onclick="ConfirmDeleteWorkout" disabled="@isDeletingWorkout">
                    <i class="fa-solid fa-trash"></i>
                    @(isDeletingWorkout ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid WorkoutId { get; set; }

    private Workout? myWorkout;
    private List<Exercise> workoutExercises = new();

    private bool isLoading;
    private bool isDeletingWorkout;
    private bool isStartingWorkout;
    private bool showConfirmDeleteWorkoutPopup;
    private bool showMobileActions;

    private readonly CancellationTokenSource _cancellationTokenSource = new();

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private WorkoutsService WorkoutsService { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            isLoading = true;

            var tasks = new[]
            {
                LoadMyWorkoutAsync(_cancellationTokenSource.Token),
                LoadExercisesAsync(_cancellationTokenSource.Token)
            };

            await Task.WhenAll(tasks);
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de pagina wordt verlaten.
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMyWorkoutAsync(CancellationToken cancellationToken)
    {
        myWorkout = await WorkoutsService.GetWorkoutByIdAsync(WorkoutId, cancellationToken);
    }

    private async Task LoadExercisesAsync(CancellationToken cancellationToken)
    {
        workoutExercises = await WorkoutsService.GetExercisesByWorkoutIdAsync(WorkoutId, cancellationToken);
    }

    private async Task ConfirmDeleteWorkout()
    {
        if (isDeletingWorkout)
            return;

        isDeletingWorkout = true;
        showConfirmDeleteWorkoutPopup = false;

        try
        {
            var message = await WorkoutsService.DeleteWorkoutAsync(
                WorkoutId,
                _cancellationTokenSource.Token);

            ToastService.ShowToast(message, ToastLevel.Success);
            Navigation.NavigateTo("/Workouts");
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de component wordt verlaten.
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isDeletingWorkout = false;
        }
    }

    private void NavigateToAddExerciseToWorkout()
    {
        Navigation.NavigateTo($"/MuscleGroups/{WorkoutId}");
    }

    private void NavigateToWorkoutHistory()
    {
        Navigation.NavigateTo($"/WorkoutHistory/{WorkoutId}");
    }

    private void ExerciseDetail(int exerciseId)
    {
        Navigation.NavigateTo($"/ExerciseDetail/{exerciseId}/{WorkoutId}");
    }

    private void NavigateToUpdateToWorkout()
    {
        Navigation.NavigateTo($"/CreateAndUpdateWorkout/{WorkoutId}");
    }

    private async Task StartWorkout()
    {
        if (isStartingWorkout)
            return;

        isStartingWorkout = true;

        try
        {
            var workoutSession = await WorkoutsService.StartWorkoutAsync(
                WorkoutId,
                _cancellationTokenSource.Token);

            ToastService.ShowToast("Workout started!", ToastLevel.Success);
            Navigation.NavigateTo($"/WorkoutSession/{workoutSession.Id}");
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de pagina wordt verlaten.
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isStartingWorkout = false;
        }
    }

    private void ClosePopup()
    {
        showConfirmDeleteWorkoutPopup = false;
    }

    private void OpenConfirmDeleteWorkoutPopup()
    {
        showConfirmDeleteWorkoutPopup = true;
    }

    private void ToggleMobileActions()
    {
        showMobileActions = !showMobileActions;
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
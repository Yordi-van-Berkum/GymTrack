@page "/Workouts"
@implements IDisposable

<div class="page-container">

    <div class="pagetitle-back">
        <BackButton />
        <div class="pagetitle">Workouts</div>

        <button class="mobile-menu-button" @onclick="ToggleMobileActions">
            <i class="fa-solid fa-ellipsis-vertical"></i>
        </button>

        <div class="action-buttons @(showMobileActions ? "mobile-actions-open" : "")">
            <button class="button-pageheader add-button" @onclick="CreateWorkout">
                <i class="fa-solid fa-plus fa-w"></i>
                <span>New Workout</span>
            </button>
        </div>

    </div>

    <div class="search">
        <i class="fa fa-search search-icon fa-fw"></i>
        <input type="text" class="search-input" placeholder="Search..." @bind="searchTerm" @bind:event="oninput" />
    </div>

    @if (isLoading)
    {
        <p class="status-message">Loading workouts...</p>
    }
    else if (!myWorkouts.Any())
    {
        <p class="status-message">No workouts found.</p>
    }
    else
    {
        <div class="workout-container">
            @foreach (var workout in FilteredMyWorkouts)
            {
                <div class="workout-card" @onclick="() => WorkoutDetail(workout.Id)">

                    <div class="workout-image">
                        <img src="@GetWorkoutImage(workout.Id)" alt="@workout.Name" />
                    </div>

                    <div class="workout-info">
                        <div class="workout-name">
                            @workout.Name
                        </div>

                        <div class="workout-count">
                            <span>@workout.ExerciseCount</span> exercises
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

@code {
    private string searchTerm = string.Empty;
    private bool isLoading;

    private List<Workout> myWorkouts = new();

    private bool showMobileActions;

    private readonly CancellationTokenSource _cancellationTokenSource = new();

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private WorkoutsService WorkoutsService { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            isLoading = true;
            await LoadMyWorkoutsAsync(_cancellationTokenSource.Token);
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de pagina wordt verlaten.
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMyWorkoutsAsync(CancellationToken cancellationToken)
    {
        myWorkouts = await WorkoutsService.GetMyWorkoutsAsync(cancellationToken);
    }

    private void CreateWorkout()
    {
        Navigation.NavigateTo("/CreateAndUpdateWorkout");
    }

    private void WorkoutDetail(Guid workoutId)
    {
        Navigation.NavigateTo($"/WorkoutDetail/{workoutId}");
    }

    private IEnumerable<Workout> FilteredMyWorkouts =>
        myWorkouts.Where(x =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            x.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }


    private string GetWorkoutImage(Guid workoutId)
    {
        string[] images =
        {
        "/images/Dashboard/dashboardheader.png",
        "/images/Dashboard/workoutimage1.png",
        "/images/Dashboard/workoutimage2.png",
        "/images/Dashboard/workoutimage3.png"
    };

        int workoutIndex = myWorkouts.FindIndex(x => x.Id == workoutId);

        if (workoutIndex < 0)
            workoutIndex = 0;

        return images[workoutIndex % images.Length];
    }

    private void ToggleMobileActions()
    {
        showMobileActions = !showMobileActions;
    }
}
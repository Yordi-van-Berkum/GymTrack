@page "/"

<PageTitle>Home</PageTitle>

<div class="page-container">

    <div class="dashboard-welcome-card">
        <div class="dashboard-welcome-overlay">
            <h1 class="welcome-message">
                Welcome back, <span>@userProfile?.Name!</span>
            </h1>

            <p class="ready-message">
                Ready for today's workout?
            </p>
        </div>
    </div>

    <section class="dashboard-quick-actions">

        <h2 class="quick-actions-title">Quick Actions</h2>

        <div class="quick-actions-cards">

            <div class="quick-action-card" @onclick='() => Navigation.NavigateTo("/Planning")'>
                <i class="fa-solid fa-calendar-days quick-action-icon"></i>
                <span class="quick-action-name">Planning</span>
            </div>

            <div class="quick-action-card" @onclick='() => Navigation.NavigateTo("/Workouts")'>
                <i class="fa-solid fa-dumbbell quick-action-icon"></i>
                <span class="quick-action-name">Workouts</span>
            </div>

            <div class="quick-action-card" @onclick='() => Navigation.NavigateTo("/MuscleGroups")'>
                <i class="fa-solid fa-person-running quick-action-icon"></i>
                <span class="quick-action-name">Exercises</span>
            </div>

        </div>

    </section>

</div>

@code {
    // Bevat het profiel van de ingelogde gebruiker.
    private UserProfile? userProfile;

    // Geeft aan of de gegevens nog worden geladen.
    private bool isLoading;

    // Geeft aan of er momenteel een workout wordt gestart.
    private bool isStartingWorkout;

    // Wordt gebruikt om lopende requests te annuleren wanneer de pagina wordt verlaten.
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private CancellationToken cancellationToken => _cancellationTokenSource.Token;

    [Inject] private AccountService AccountService { get; set; } = default!;
    [Inject] private PlanningService PlanningService { get; set; } = default!;
    [Inject] private WorkoutsService WorkoutsService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            isLoading = true;

            await Task.WhenAll(
                LoadUserProfileAsync()
            );
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadUserProfileAsync()
    {
        userProfile = await AccountService.GetMyProfileAsync();
    }
}
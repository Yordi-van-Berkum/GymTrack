@page "/Exercises/{MuscleGroupId:int}/{WorkoutId:guid?}"
@implements IDisposable

<div class="page-container">

    <div class="pagetitle-back">
        <BackButton />
        <div class="pagetitle">Exercises</div>
    </div>

    <div class="search">
        <i class="fa fa-search search-icon"></i>
        <input type="text" class="search-input" placeholder="Search..." @bind="searchTerm" @bind:event="oninput" />
    </div>

    @if (isLoading)
    {
        <p class="status-message">Loading exercises...</p>
    }
    else if (!FilteredExercises.Any())
    {
        <p class="status-message">No exercises found!</p>
    }
    else
    {
        <div class="exercise-container">
            @foreach (var exercise in FilteredExercises)
            {
                <div class="exercise-card" @onclick="() => ExerciseDetail(exercise.Id)">
                    <div class="exercise-image-wrapper">
                        <img src="@($"/Images/Exercises/{exercise.ImageUrl}")" alt="@exercise.Name" class="exercise-image" />
                    </div>

                    <div class="exercise-name">@exercise.Name</div>
                </div>
            }
        </div>
    }

</div>

@code {
    // WorkoutId bepaalt of de pagina vanuit een bestaande workout wordt geopend.
    [Parameter] public Guid? WorkoutId { get; set; }

    private bool WorkoutMode => WorkoutId.HasValue;

    private string searchTerm = string.Empty;

    [Parameter]
    public int MuscleGroupId { get; set; }

    private List<Exercise> exercises = new();

    private bool isLoading;

    private readonly CancellationTokenSource _cancellationTokenSource = new();

    [Inject] private ExercisesService ExercisesService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            isLoading = true;
            await LoadExercisesAsync(_cancellationTokenSource.Token);
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de pagina wordt verlaten.
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExercisesAsync(CancellationToken cancellationToken)
    {
        exercises = await ExercisesService.GetExercisesByMuscleGroupIdAsync(MuscleGroupId, cancellationToken);
    }

    private void ExerciseDetail(int exerciseId)
    {
        // In WorkoutMode wordt de WorkoutId meegestuurd naar de detailpagina.
        if (WorkoutMode)
        {
            Navigation.NavigateTo($"/ExerciseDetail/{exerciseId}/{WorkoutId}");
        }
        else
        {
            Navigation.NavigateTo($"/ExerciseDetail/{exerciseId}");
        }
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    private IEnumerable<Exercise> FilteredExercises =>
        exercises.Where(x =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            x.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
}
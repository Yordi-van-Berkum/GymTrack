@page "/MuscleGroups/{WorkoutId:guid?}"
@implements IDisposable

<div class="page-container">

    <div class="pagetitle-back">
        <BackButton />
        <div class="pagetitle">Muscle Groups</div>
    </div>

    <div class="search">
        <i class="fa fa-search search-icon fa-fw"></i>
        <input type="text" class="search-input" placeholder="Search..." @bind="searchTerm" @bind:event="oninput" />
    </div>

    @if (isLoading)
    {
        <p class="status-message">Loading muscle groups...</p>
    }
    else if (!FilteredMuscleGroups.Any())
    {
        <p class="status-message">No muscle groups found!</p>
    }
    else
    {
        <div class="musclegroup-container">
            @foreach (var muscle in FilteredMuscleGroups)
            {
                <div class="musclegroup-card" @onclick="@(() => NavigateToExercises(muscle.Id))">
                    <div class="musclegroup-image-wrapper">
                        <img src="@($"/Images/Musclegroups/{muscle.ImageUrl}")" alt="@muscle.Name" class="musclegroup-image" />
                    </div>

                    <div class="musclegroup-name">@muscle.Name</div>

                    <div class="musclegroup-count">
                        <span>@muscle.ExerciseCount</span>
                        Exercises
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    // WorkoutId bepaalt of de pagina vanuit een bestaande workout wordt geopend.
    [Parameter] public Guid? WorkoutId { get; set; }

    private bool WorkoutMode => WorkoutId.HasValue;

    private string searchTerm = string.Empty;
    private List<MuscleGroup> muscleGroups = new();
    private bool isLoading;

    private readonly CancellationTokenSource _cancellationTokenSource = new();

    [Inject] private ExercisesService ExercisesService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            isLoading = true;
            await LoadMuscleGroupsAsync(_cancellationTokenSource.Token);
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de pagina wordt verlaten.
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMuscleGroupsAsync(CancellationToken cancellationToken)
    {
        muscleGroups = await ExercisesService.GetMuscleGroupsAsync(cancellationToken);
    }

    private void NavigateToExercises(int muscleGroupId)
    {
        // In WorkoutMode moet de WorkoutId worden meegestuurd naar de oefeningenpagina.
        if (WorkoutMode)
        {
            Navigation.NavigateTo($"/Exercises/{muscleGroupId}/{WorkoutId}");
        }
        else
        {
            Navigation.NavigateTo($"/Exercises/{muscleGroupId}");
        }
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    private IEnumerable<MuscleGroup> FilteredMuscleGroups =>
        muscleGroups.Where(x =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            x.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
}
@page "/ExerciseDetail/{ExerciseId:int}/{WorkoutId:guid?}"
@implements IDisposable

<div class="page-container">

    @if (isLoading)
    {
        <p class="status-message">Loading exercise...</p>
    }
    else if (exercise is null)
    {
        <p class="status-message">Exercise not found.</p>
    }
    else
    {
        <div class="pagetitle-back">
            <BackButton />
            <div class="pagetitle">@exercise.Name</div>

            @if (WorkoutMode)
            {
                <button class="mobile-menu-button" @onclick="ToggleMobileActions">
                    <i class="fa-solid fa-ellipsis-vertical"></i>
                </button>

                <div class="action-buttons @(showMobileActions ? "mobile-actions-open" : "")">
                    @if (IsExerciseInWorkout)
                    {
                        <button class="button-pageheader delete-button"
                                @onclick="() => OpenConfirmDeleteExerciseFromWorkoutPopup(exercise)"
                                disabled="@isDeletingExerciseFromWorkout">
                            <i class="fa-solid fa-x"></i>
                            <span>@(isDeletingExerciseFromWorkout ? "Removing..." : $"Remove {exercise.Name} from {myWorkout.Name}")</span>
                        </button>
                    }
                    else
                    {
                        <button class="button-pageheader add-button"
                                @onclick="() => OpenConfirmAddExerciseToWorkoutPopup(exercise)"
                                disabled="@isAddingExercise">
                            <i class="fa-solid fa-plus"></i>
                            @(isAddingExercise ? "Adding..." : $"Add {exercise.Name} to {myWorkout.Name}")
                        </button>
                    }
                </div>
            }
        </div>

        <div class="exercise-detail-card">
            <img class="exercise-detail-image" src="@($"/Images/Exercises/{exercise.ImageUrl}")" alt="@exercise.Name" />

            <div class="exercise-detail-content">
                <h2 class="exercise-detail-name">@exercise.Name</h2>
                <p class="exercise-detail-description">@exercise.Description</p>
            </div>
        </div>

        <div class="exercise-stats-container">

            <div class="exercise-personal-record-card">
                <div class="exercise-personal-record-header">
                    <i class="fa-solid fa-trophy"></i>
                    <span>Personal Record</span>
                </div>

                @if (personalRecord is null)
                {
                    <div class="exercise-personal-record-empty">No record yet</div>
                }
                else
                {
                    <div class="exercise-personal-record-stats">
                        <div class="exercise-personal-record-stat">
                            <span class="exercise-personal-record-value">@personalRecord.Weight kg</span>
                            <span class="exercise-personal-record-label">Weight</span>
                        </div>

                        <div class="exercise-personal-record-divider"></div>

                        <div class="exercise-personal-record-stat">
                            <span class="exercise-personal-record-value">@personalRecord.Reps</span>
                            <span class="exercise-personal-record-label">Reps</span>
                        </div>
                    </div>
                }
            </div>

            <div class="exercise-personal-record-card">
                <div class="exercise-personal-record-header">
                    <i class="fa-solid fa-clock"></i>
                    <span>Last Performed</span>
                </div>

                @if (lastPerformed is null)
                {
                    <div class="exercise-personal-record-empty">Not performed yet</div>
                }
                else
                {
                    <div class="exercise-personal-record-stats">
                        <div class="exercise-personal-record-stat">
                            <span class="exercise-personal-record-value">@lastPerformed.Weight kg</span>
                            <span class="exercise-personal-record-label">Weight</span>
                        </div>

                        <div class="exercise-personal-record-divider"></div>

                        <div class="exercise-personal-record-stat">
                            <span class="exercise-personal-record-value">@lastPerformed.Reps</span>
                            <span class="exercise-personal-record-label">Reps</span>
                        </div>
                    </div>
                }
            </div>

        </div>
    }

</div>

@if (showConfirmExerciseToWorkoutPopup)
{
    <div class="confirm-modal-overlay">
        <div class="confirm-modal-content">
            <div class="confirm-modal-title">
                Add <span>@selectedExerciseName</span> To <span>@myWorkout.Name</span>
            </div>

            <div class="confirm-modal-actions">
                <button class="confirm-modal-btn confirm-modal-btn-cancel" @onclick="ClosePopup" disabled="@isAddingExercise">
                    <i class="fa-solid fa-x"></i>
                    Cancel
                </button>

                <button class="confirm-modal-btn confirm-modal-btn-confirm" @onclick="ConfirmAddExerciseToWorkout" disabled="@isAddingExercise">
                    <i class="fa-solid fa-plus"></i>
                    Add Exercise
                </button>
            </div>
        </div>
    </div>
}

@if (showConfirmDeleteExerciseFromWorkoutPopup)
{
    <div class="confirm-modal-overlay">
        <div class="confirm-modal-content">
            <div class="confirm-modal-title">
                You want to delete <span>@selectedExerciseName</span>?
            </div>

            <div class="confirm-modal-actions">
                <button class="confirm-modal-btn confirm-modal-btn-cancel" @onclick="ClosePopup" disabled="@isDeletingExerciseFromWorkout">
                    <i class="fa-solid fa-x"></i>
                    Cancel
                </button>

                <button class="confirm-modal-btn confirm-modal-btn-delete" @onclick="ConfirmRemoveExerciseFromWorkout" disabled="@isDeletingExerciseFromWorkout">
                    <i class="fa-solid fa-trash"></i>
                    @(isDeletingExerciseFromWorkout ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    // WorkoutId bepaalt of de pagina vanuit een bestaande workout wordt geopend.
    [Parameter] public Guid? WorkoutId { get; set; }

    private bool WorkoutMode => WorkoutId.HasValue;

    private bool IsExerciseInWorkout;

    [Parameter]
    public int ExerciseId { get; set; }

    private ExercisePersonalRecord? personalRecord;
    private ExerciseLastPerformed? lastPerformed;

    [Inject] private ExercisesService ExercisesService { get; set; } = default!;
    [Inject] private WorkoutsService WorkoutsService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private Exercise? exercise;
    private Workout? myWorkout;

    private bool isLoading;
    private bool isAddingExercise;
    private bool isDeletingExerciseFromWorkout;

    private readonly CancellationTokenSource _cancellationTokenSource = new();

    private bool showConfirmExerciseToWorkoutPopup;
    private bool showConfirmDeleteExerciseFromWorkoutPopup;

    private int selectedExerciseId;
    private string selectedExerciseName = string.Empty;

    private bool showMobileActions;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            isLoading = true;

            var tasks = new List<Task>
            {
                LoadExerciseDetailAsync(_cancellationTokenSource.Token),
                LoadPersonalRecordAsync(_cancellationTokenSource.Token),
                LoadLastPerformedAsync(_cancellationTokenSource.Token)
            };

            if (WorkoutMode)
            {
                tasks.Add(LoadMyWorkoutAsync(_cancellationTokenSource.Token));
                tasks.Add(CheckIfExerciseIsInWorkoutAsync(_cancellationTokenSource.Token));
            }

            await Task.WhenAll(tasks);
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de pagina wordt verlaten.
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExerciseDetailAsync(CancellationToken cancellationToken)
    {
        exercise = await ExercisesService.GetExerciseByIdAsync(ExerciseId, cancellationToken);
    }

    private async Task LoadMyWorkoutAsync(CancellationToken cancellationToken)
    {
        if (!WorkoutId.HasValue)
            return;

        myWorkout = await WorkoutsService.GetWorkoutByIdAsync(WorkoutId.Value, cancellationToken);
    }

    private async Task ConfirmAddExerciseToWorkout()
    {
        if (isAddingExercise || !WorkoutId.HasValue)
            return;

        isAddingExercise = true;
        showConfirmExerciseToWorkoutPopup = false;

        try
        {
            var message = await WorkoutsService.AddExerciseToWorkoutAsync(
                WorkoutId.Value,
                selectedExerciseId,
                _cancellationTokenSource.Token);

            ToastService.ShowToast(message, ToastLevel.Success);
            Navigation.NavigateTo($"/WorkoutDetail/{WorkoutId.Value}");
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de component wordt verlaten.
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isAddingExercise = false;
        }
    }

    private async Task ConfirmRemoveExerciseFromWorkout()
    {
        if (isDeletingExerciseFromWorkout || !WorkoutId.HasValue)
            return;

        isDeletingExerciseFromWorkout = true;
        showConfirmDeleteExerciseFromWorkoutPopup = false;

        try
        {
            var message = await WorkoutsService.DeleteExerciseFromWorkoutAsync(
                WorkoutId.Value,
                ExerciseId,
                _cancellationTokenSource.Token);

            ToastService.ShowToast(message, ToastLevel.Success);
            Navigation.NavigateTo($"/WorkoutDetail/{WorkoutId.Value}");
        }
        catch (OperationCanceledException)
        {
            // Request is geannuleerd wanneer de component wordt verlaten.
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isDeletingExerciseFromWorkout = false;
        }
    }

    private async Task LoadPersonalRecordAsync(CancellationToken cancellationToken)
    {
        personalRecord = await ExercisesService.GetExercisePersonalRecordAsync(ExerciseId, cancellationToken);
    }

    private async Task LoadLastPerformedAsync(CancellationToken cancellationToken)
    {
        lastPerformed = await ExercisesService.GetExerciseLastPerformedAsync(ExerciseId, cancellationToken);
    }

    private async Task CheckIfExerciseIsInWorkoutAsync(CancellationToken cancellationToken)
    {
        if (!WorkoutId.HasValue)
            return;

        IsExerciseInWorkout = await WorkoutsService.IsExerciseInWorkoutAsync(
            WorkoutId.Value,
            ExerciseId,
            cancellationToken);
    }

    private void OpenConfirmAddExerciseToWorkoutPopup(Exercise exercise)
    {
        selectedExerciseId = exercise.Id;
        selectedExerciseName = exercise.Name;
        showConfirmExerciseToWorkoutPopup = true;
    }

    private void OpenConfirmDeleteExerciseFromWorkoutPopup(Exercise exercise)
    {
        selectedExerciseId = exercise.Id;
        selectedExerciseName = exercise.Name;
        showConfirmDeleteExerciseFromWorkoutPopup = true;
    }

    private void ClosePopup()
    {
        showConfirmExerciseToWorkoutPopup = false;
        showConfirmDeleteExerciseFromWorkoutPopup = false;
    }

    private void ToggleMobileActions()
    {
        showMobileActions = !showMobileActions;
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
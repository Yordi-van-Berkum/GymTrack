@page "/Profile"
@attribute [Authorize(Roles = "Admin")]

@if (userProfile == null)
{
    <p><em>@message</em></p>
}
else
{
    <h3 class="mb-3">Profile</h3>

    <div class="row mb-3">
        <div class="col-md-3 col-form-label">Name</div>
        <div class="col-md-8">
            <input class="form-control-plaintext" readonly @bind="userProfile.Name" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3 col-form-label">Email</div>
        <div class="col-md-8">
            <input class="form-control-plaintext" readonly @bind="userProfile.Email" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3 col-form-label">Phone</div>
        <div class="col-md-8">
            <input class="form-control-plaintext" readonly @bind="userProfile.PhoneNumber" />
        </div>
    </div>
}

@inject HttpClient httpClient
@code {
    public UserProfile? userProfile = null;
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            message = "Loading...";
            userProfile = await httpClient.GetFromJsonAsync<UserProfile>("api/Account/Profile");
        }
        catch
        {
            message = "Cannot read user profile!";
        }
    }
}
